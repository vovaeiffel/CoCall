{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "lib": [
            "ES2022",
            "DOM"
        ]
    },
    "include": [
        "src/main.ts",
        "src/preload.ts",
        "src/signaling.ts",
        "src/protocol.ts",
        "src/global.d.ts"
    ]
}